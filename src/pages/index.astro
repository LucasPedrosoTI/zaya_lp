---
import Base from '../layouts/Base.astro';
import Benefits from '../components/Benefits.astro';
import Cuidados from '../components/Cuidados.astro';
import Dentist from '../components/Dentist.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import Gallery from '../components/Gallery.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Location from '../components/Location.astro';
import Reviews from '../components/Reviews.astro';
import TaglineReveal from '../components/TaglineReveal.astro';
import { businessJsonLd, faqJsonLd, seo } from '../data/clinic';
import { hasLogo, listClinicPhotos } from '../lib/assets';

const showLogo = hasLogo();
const images = listClinicPhotos();
---

<Base title={seo.title} description={seo.description} home>
  <main id="conteudo" tabindex="-1" class="focus:outline-none">
    <Hero showLogo={showLogo} />
    <Cuidados />
    <Benefits />
    <TaglineReveal />
    <HowItWorks />
    <Reviews />
    <Dentist />
    <Gallery images={images} />
    <Faq />
    <Location />
    <FinalCta />
  </main>
  <Footer />
  <script type="application/ld+json" set:html={businessJsonLd} />
  <script type="application/ld+json" set:html={faqJsonLd} />
</Base>
