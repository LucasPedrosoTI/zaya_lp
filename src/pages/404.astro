---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Página não encontrada | Zaya Odontologia Humanizada"
  description="Esse endereço não leva a uma página da Zaya."
  currentLabel="Não encontrada"
  noindex
>
  <main id="conteudo" tabindex="-1" class="mx-auto max-w-[680px] px-4 pt-24 pb-24 focus:outline-none">
    <p class="font-sans text-xs font-light tracking-widest text-stone uppercase">404</p>
    <h1 class="mt-4 text-4xl md:text-5xl">Essa página não existe.</h1>
    <p class="mt-6 text-base">O endereço pode ter mudado. Volte para a página da clínica.</p>
    <div class="mt-8">
      <Cta href="/">Voltar para o início</Cta>
    </div>
  </main>
  <Footer />
</Base>
