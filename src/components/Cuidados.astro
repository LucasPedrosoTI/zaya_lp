---
import { cuidados } from '../data/clinic';
---

<section id="cuidados" class="bg-white">
  <div class="mx-auto max-w-7xl px-4 pt-24 pb-12 md:px-6" data-reveal>
    <p class="font-sans text-xs font-light tracking-widest text-stone uppercase">Cuidados</p>
    <h2 class="mt-4 max-w-[680px] text-4xl md:text-5xl">O que você pode resolver aqui</h2>
    <p class="mt-6 max-w-[680px] text-base text-black">
      Quatro motivos para marcar a avaliação. Cada um começa com uma conversa.
    </p>
  </div>
  <ol>
    {
      cuidados.map((item, index) => (
        <li id={item.id} class:list={[index % 2 === 0 ? 'bg-sand' : 'bg-white']}>
          <div
            class="mx-auto grid max-w-7xl items-start gap-4 px-4 py-12 md:grid-cols-12 md:px-6"
            data-reveal
          >
            <p class="font-display text-4xl tabular-nums md:col-span-2">
              {String(index + 1).padStart(2, '0')}
            </p>
            <h3 class="text-3xl md:col-span-4">{item.title}</h3>
            <p class="text-base text-black md:col-span-5 md:col-start-8">{item.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
