---
import Cta from './Cta.astro';
import Icon from './Icon.astro';
import { address, ctaLabel, mapsUrl, whatsappUrl } from '../data/clinic';
---

<section id="onde" class="bg-white">
  <div class="mx-auto grid max-w-7xl items-start gap-12 px-4 py-24 md:grid-cols-12 md:px-6">
    <div class="md:col-span-7" data-reveal>
      <p class="font-sans text-xs font-light tracking-widest text-stone uppercase">Onde estamos</p>
      <h2 class="mt-4 max-w-[680px] text-4xl md:text-5xl">Vila Curuçá, São Miguel Paulista</h2>
      <address class="mt-8 text-lg">
        {address.street}<br />
        {address.area}<br />
        {address.cep}
      </address>
    </div>
    <div class="flex flex-col items-start gap-6 md:col-span-4 md:col-start-9" data-reveal>
      <p class="flex items-start gap-2 text-base">
        <Icon name="pin" class="mt-1 h-4 w-4 shrink-0" />
        <span>A marcação não pede encaminhamento. É só mandar mensagem.</span>
      </p>
      <a
        href={mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-base font-semibold transition-all duration-700 ease-fluid hover:text-stone focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-offset-2 focus-visible:outline-black active:translate-y-px"
      >
        Abrir no Google Maps
        <Icon name="arrow" class="h-4 w-4" />
      </a>
      <Cta href={whatsappUrl} external>{ctaLabel}</Cta>
    </div>
  </div>
</section>
