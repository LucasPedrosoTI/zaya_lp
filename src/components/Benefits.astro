---
import { benefits } from '../data/clinic';
---

<section id="por-que" class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-24 md:px-6">
    <div data-reveal>
      <p class="font-sans text-xs font-light tracking-widest text-stone uppercase">Por que a Zaya</p>
      <h2 class="mt-4 max-w-[680px] text-4xl md:text-5xl">O que sustenta cada consulta</h2>
      <p class="mt-6 max-w-[680px] text-base">Da avaliação ao retorno, cada passo é dito antes.</p>
    </div>
    <ol class="mt-16 flex flex-col gap-8">
      {
        benefits.map((item, index) => (
          <li class="flex flex-col gap-8" data-reveal>
            <div class="h-px bg-sand" aria-hidden="true" />
            <div
              class:list={[
                'grid gap-4 md:grid-cols-12',
                index % 2 === 1 && 'md:ps-24',
              ]}
            >
              <p class="font-display text-5xl tabular-nums md:col-span-3">
                {String(index + 1).padStart(2, '0')}
              </p>
              <div class="md:col-span-7">
                <h3 class="text-2xl sm:text-3xl">{item.title}</h3>
                <p class="mt-3 text-base">{item.text}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
