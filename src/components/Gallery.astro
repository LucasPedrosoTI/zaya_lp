---
import type { GalleryImage } from '../lib/assets';

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

{
  images.length > 0 && (
    <section id="espaco" class="bg-white" aria-labelledby="espaco-titulo">
      <div class="mx-auto max-w-7xl px-4 py-24 md:px-6">
        <div data-reveal>
          <p class="font-sans text-xs font-light tracking-widest text-stone uppercase">Espaço</p>
          <h2 id="espaco-titulo" class="mt-4 max-w-[680px] text-4xl md:text-5xl">
            A clínica, em fotos
          </h2>
        </div>
        <ul class="mt-16 grid gap-6 md:grid-cols-12">
          {images.map((image, index) => (
            <li
              class:list={[index === 0 ? 'md:col-span-7' : 'md:col-span-5']}
              data-reveal
            >
              <figure class="overflow-hidden rounded-3xl bg-sand">
                <img
                  src={image.src}
                  alt={image.alt}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] w-full object-cover"
                />
                <figcaption class="px-4 py-4 text-sm text-black">{image.alt}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
