---
import Icon from './Icon.astro';

interface Props {
  href: string;
  size?: 'md' | 'sm';
  tone?: 'black' | 'sand' | 'white';
  external?: boolean;
}

const { href, size = 'md', tone = 'black', external = false } = Astro.props;
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a
  href={href}
  {...externalAttrs}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-full px-3 py-2 font-sans font-semibold transition-all duration-700 ease-fluid active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-offset-2',
    size === 'sm' ? 'text-sm' : 'text-base',
    tone === 'black' &&
      'bg-black text-white hover:bg-sand hover:text-black focus-visible:outline-black',
    tone === 'sand' && 'bg-sand text-black hover:bg-white focus-visible:outline-black',
    tone === 'white' && 'bg-white text-black hover:bg-sand focus-visible:outline-black',
  ]}
>
  <slot />
  {external && <Icon name="arrow" class="h-4 w-4" />}
</a>
